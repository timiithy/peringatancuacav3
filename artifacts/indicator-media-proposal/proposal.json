  "items": [
    {
      "id": 1,
      "kind": "motion",
      "ref": "clouds",
      "note": "Original motion sketch: a cloud lowers and gathers, shown as three numbered observations. The reference photo establishes cloud appearance only; it does not document the three repetitions.",
      "asset": "assets/wn-1.svg",
      "bytes": 1753,
      "label": "Awan tampak turun dan menggumpal hingga tiga kali"
    },
    {
      "id": 2,
      "kind": "motion",
      "ref": "clouds",
      "note": "Original motion sketch: separate cloud masses approach and meet. A single cloud photo cannot show that change.",
      "asset": "assets/wn-2.svg",
      "bytes": 1247,
      "label": "Beberapa gumpalan awan tampak saling mendekat atau menyatu"
    },
    {
      "id": 3,
      "kind": "photo",
      "ref": "lightning",
      "note": "Real lightning over the sea. Keep the wording about one side / alternating sides; this still does not demonstrate timing. Optional slow two-panel illustration if the sequence needs more explanation.",
      "asset": "assets/lightning.webp",
      "bytes": 14522,
      "label": "Petir terlihat di satu sisi langit atau bergantian di dua sisi"
    },
    {
      "id": 4,
      "kind": "diagram",
      "note": "Original comparison: small, closely spaced waves become larger, closely spaced waves. This is a schematic, not a measured wave-height scale or time interval.",
      "asset": "assets/wn-4.svg",
      "bytes": 1342,
      "label": "Ombak berubah dari kecil dan rapat menjadi besar dan berdekatan"
    },
    {
      "id": 5,
      "kind": "photo",
      "ref": "dolphin-common",
      "alternate": "dolphin-front",
      "note": "Dolphins photographed riding a boat’s bow wave. The animal is clear at card size. The boat is outside the frame, and the photo does not establish intent to guide it; retain the full observation wording.",
      "asset": "assets/dolphin-common.webp",
      "bytes": 35264,
      "label": "Lumba-lumba mendekati perahu, seolah-olah menuntun arah"
    },
    {
      "id": 6,
      "kind": "photo",
      "ref": "gull-motion",
      "note": "Seagull in flight; the source describes motion blur. Speed and loud calls remain explicit in the text. No autoplay audio.",
      "asset": "assets/gull-motion.webp",
      "bytes": 6386,
      "label": "Burung camar terbang cepat sambil bersuara keras"
    },
    {
      "id": 7,
      "kind": "diagram",
      "note": "Original season-transition diagram: Musim angin barat → Musim angin timur. This represents a change of season, not the direction of a single gust.",
      "asset": "assets/wn-7.svg",
      "bytes": 1326,
      "label": "Sedang terjadi pergantian musim angin barat ke angin timur"
    },
    {
      "id": 8,
      "kind": "photo",
      "ref": "overcast",
      "note": "Overcast sea with daylight still visible. Review whether this brightness matches “tidak terlalu gelap”; avoid swapping it for a severe, nearly black storm image.",
      "asset": "assets/overcast.webp",
      "bytes": 6286,
      "label": "Langit tertutup awan, tetapi tidak terlalu gelap"
    },
    {
      "id": 9,
      "kind": "photo",
      "ref": "rain",
      "note": "Rain shafts over the sea. A photo cannot establish the local wind season; “saat musim angin timur” stays in the text.",
      "asset": "assets/rain.webp",
      "bytes": 12310,
      "label": "Hujan turun atau awan tebal menutupi langit saat musim angin timur"
    },
    {
      "id": 10,
      "kind": "photo",
      "ref": "clear-blue",
      "note": "A genuinely cloudless blue sky. The source landscape is in Wales, so this is an appearance example only. Keep the west-wind season in the description; do not label the photo as an Indonesian observation.",
      "asset": "assets/clear-blue.webp",
      "bytes": 42778,
      "label": "Langit cerah tanpa awan saat musim angin barat"
    },
    {
      "id": 11,
      "kind": "motion",
      "note": "Original ear and sound-wave illustration for a loud rumble, one to seven times. Avoid a lightning photograph: it would add a visual condition that this sound-only indicator does not require.",
      "asset": "assets/wn-11.svg",
      "bytes": 1166,
      "label": "Terdengar suara gemuruh keras, sekali atau hingga tujuh kali"
    },
    {
      "id": 12,
      "kind": "motion",
      "ref": "stars",
      "note": "Original gentle twinkling star sketch, with a real night-sky reference. The animation explains twinkling; the west-wind season stays in text. Reference exposure is not a naked-eye visibility standard.",
      "asset": "assets/wn-12.svg",
      "bytes": 3202,
      "label": "Banyak bintang tampak berkelap-kelip saat musim angin barat"
    },
    {
      "id": 13,
      "kind": "diagram",
      "ref": "night",
      "note": "Original dark sky without visible stars. The reference photo is rejected for use because street lighting could imply an unrelated cause. Keep the east-wind season in text.",
      "asset": "assets/wn-13.svg",
      "bytes": 784,
      "label": "Bintang tidak terlihat pada malam hari saat musim angin timur"
    },
    {
      "id": 14,
      "kind": "photo",
      "ref": "halo",
      "note": "Moon halo with nearby points of light as a visual reference. A larger annotated moon/star diagram could clarify the relationship at small sizes. The image is not evidence of the season or an exact local observation.",
      "asset": "assets/halo.webp",
      "bytes": 1534,
      "label": "Bintang tampak dekat atau sejajar dengan bulan, termasuk di dalam lingkaran cahaya bulan"
    },
    {
      "id": 15,
      "kind": "motion",
      "ref": "cockroach",
      "note": "Original simplified cockroaches flying above the inside of a boat. Search found insect/wing references, but no suitable reusable photo of this exact behavior in a boat. This is an illustration, not documentary footage.",
      "asset": "assets/wn-15.svg",
      "bytes": 2497,
      "label": "Kecoa beterbangan di dalam perahu"
    },
    {
      "id": 16,
      "kind": "diagram",
      "ref": "scorpius",
      "note": "Simplified illustration of the approved arrangement: the Moon is clearly positioned between two highlighted claws, with Indonesian labels and a recognizable curved constellation tail. This replaces the detailed reference chart.",
      "asset": "assets/wn-16.svg",
      "bytes": 2612,
      "label": "Bulan terlihat di antara dua capit rasi bintang Kalajengking (Bintang Kala)"
    },
    {
      "id": 17,
      "kind": "photo",
      "ref": "whale",
      "alternate": "whale-motion",
      "note": "Real tail-slap photograph. A reusable slow-motion clip is also linked; its 80 MB original is unsuitable for direct loading. If animation is chosen, trim and compress a short excerpt to the motion budget before adding it.",
      "asset": "assets/whale.webp",
      "bytes": 11662,
      "label": "Paus muncul ke permukaan dan mengibaskan ekornya"
    }
